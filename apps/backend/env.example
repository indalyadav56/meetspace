# Copy to .env for local development. Values here override configs/<APP_ENV>.yaml.
# All keys use the APP_ prefix; nested config keys join with underscores.

APP_ENV=dev

# JWT — REQUIRED. The server refuses to start without a non-empty secret.
# Use a long, random value in any shared or production environment.
APP_JWT_SECRET=dev-only-change-me
APP_JWT_ISSUER=meetspace
APP_JWT_ACCESS_TOKEN_TTL=15m
APP_JWT_REFRESH_TOKEN_TTL=720h

# Postgres (matches docker-compose.yaml)
APP_POSTGRES_HOST=localhost
APP_POSTGRES_PORT=5432
APP_POSTGRES_USER=meetspace
APP_POSTGRES_PASSWORD=meetspace
APP_POSTGRES_DATABASE=meetspace
APP_POSTGRES_SSL_MODE=disable
