# Copy to .env for local development. Values here override configs/<APP_ENV>.yaml.
# All keys use the APP_ prefix; nested config keys join with underscores.

APP_ENV=dev

# JWT — REQUIRED. The server refuses to start without a non-empty secret.
APP_JWT_SECRET=dev-only-change-me

# Postgres / Redis (match docker-compose.yaml)
APP_POSTGRES_HOST=localhost
APP_POSTGRES_PASSWORD=meetspace
APP_REDIS_HOST=localhost

# Self-hosted LiveKit (match deploy/livekit.yaml)
APP_LIVEKIT_URL=ws://localhost:7880
APP_LIVEKIT_API_URL=http://localhost:7880
APP_LIVEKIT_API_KEY=devkey
APP_LIVEKIT_API_SECRET=meetspace-dev-livekit-secret-0123456789

# AI assistant (Google ADK + Gemini). Leave empty to disable.
APP_AI_GEMINI_API_KEY=
APP_AI_MODEL=gemini-3.5-flash

APP_MEDIA_DIR=./data/media
APP_WEB_URL=http://localhost:5173
