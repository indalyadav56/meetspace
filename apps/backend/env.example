# Copy to .env for local development. Values here override configs/<APP_ENV>.yaml.
# All keys use the APP_ prefix; nested config keys join with underscores.

APP_ENV=dev

# JWT — REQUIRED. The server refuses to start without a non-empty secret.
APP_JWT_SECRET=dev-only-change-me

# Postgres / Redis (match docker-compose.yaml)
APP_POSTGRES_HOST=localhost
APP_POSTGRES_PASSWORD=meetspace
APP_REDIS_HOST=localhost

# Self-hosted LiveKit (match deploy/livekit.yaml)
APP_LIVEKIT_URL=ws://localhost:7880
APP_LIVEKIT_API_URL=http://localhost:7880
APP_LIVEKIT_API_KEY=devkey
APP_LIVEKIT_API_SECRET=meetspace-dev-livekit-secret-0123456789

# AI assistant (Google ADK + Gemini). Leave empty to disable.
APP_AI_GEMINI_API_KEY=
APP_AI_MODEL=gemini-3.5-flash

# Clip and call recordings: MinIO (default) or "filesystem" (APP_MEDIA_DIR).
APP_MEDIA_STORAGE=minio
APP_MEDIA_DIR=./data/media
APP_MINIO_ENDPOINT=localhost:9000
APP_MINIO_ACCESS_KEY=meetspace
APP_MINIO_SECRET_KEY=meetspace-dev-minio-secret
APP_MINIO_BUCKET=meetspace-media
APP_MINIO_USE_SSL=false
APP_WEB_URL=http://localhost:5173

# Email (password resets, invites) via the Resend API: an API key with sending access is all you need.
APP_RESEND_API_KEY=
# Optional. Defaults to "Meetspace <onboarding@resend.dev>", which only delivers to your Resend account's
# own address; use a domain verified in Resend to email anyone.
# APP_RESEND_FROM=Meetspace <noreply@yourdomain.com>

# Encrypts stored integration tokens (GitHub). Use a long random string in production.
APP_INTEGRATIONS_ENCRYPTION_KEY=
